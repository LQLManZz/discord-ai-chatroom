# Run `npm run setup` to fill this in interactively, or copy to .env and edit.

# --- Language: en (default) | vi ---
LANGUAGE=en
# Language agents write their reports in (defaults to the one above)
CHAT_LANGUAGE=

# --- Discord ---
DISCORD_TOKEN=
# Lobby channel ID; the bot builds the rest of the hub (categories, monitoring and workspace channels) around it
CHANNEL_ID=
# Discord user IDs allowed to command the bot and approve plans (comma separated). Empty = server owner only
ALLOWED_USER_IDS=
# 1 = also DM you final reports, failures and quota pauses
REPORT_DM=0

# --- Workspace ---
# Default folder agents work in (each `!workspace <path>` adds another one)
WORKSPACE_DIR=./workspace
MAX_PARALLEL=3
TASK_TIMEOUT_MIN=30
# plan -> execute -> review rounds per job
MAX_ROUNDS=3

# --- Permissions ---
# safe: agents may edit files only · full: agents may also run any shell command
AGENT_AUTONOMY=safe
# Folders (and their subfolders) that always get full autonomy, comma separated
FULL_AUTONOMY_DIRS=./workspace

# --- Agents (installed CLIs are detected automatically) ---
ORCHESTRATOR_MODEL=opus
SONNET_MODEL=sonnet
HAIKU_MODEL=haiku
GEMINI_MODEL=gemini-3.8-flash-high
DEEPSEEK_MODEL=deepseek-flash
# Agent keys to switch off even if their CLI is installed, e.g. gemini-flash,deepseek-flash
AGENTS_DISABLED=
# Codex with an OpenAI login/API key
CODEX_GPT_ENABLED=0
CODEX_GPT_PROVIDER=openai
CODEX_GPT_MODEL=gpt-5.6-sol

# --- Quota (needs onWatch, optional) ---
# Ping in #alerts when a quota drops below this %
QUOTA_ALERT_PCT=10
# Stop handing work to an agent below this %: its tasks wait and the job resumes after the reset
QUOTA_STOP_PCT=2
